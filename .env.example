# Copy to .env and fill in the values.
# DB_URL accepts either JDBC format (jdbc:postgresql://...) or plain psycopg3 DSN.
DB_URL=jdbc:postgresql://localhost:5432/photovault
DB_USER=photovault
DB_PASSWORD=change-me

# Absolute path to the root directory where medium.jpg files are stored.
# Must match PHOTO_STORAGE_ROOT used by the PhotoVault server.
PHOTO_STORAGE_ROOT=/data/photos

# Directory that holds the .npz vector store files (one file per model).
# File name is derived automatically: <MODEL_ID>.npz  e.g. mobileclip-s2-datacompdr.npz
VECTOR_STORE_DIR=/data/vectors

# Path to the PL->EN prompt mapping file (relative to cwd or absolute).
PROMPTS_PATH=prompts.yaml

# Scoring knobs (optional — defaults shown)
TAG_THRESHOLD=0.25        # cosine similarity floor for a tag to be assigned
CATEGORY_TOP_K=1          # how many categories to assign per photo (top-k)
CATEGORY_MIN_SCORE=0.0    # minimum score a category must reach to be assigned

# ── Phase 2 — face pipeline ──────────────────────────────────────────────────

# Directory for the face vector store (can be the same as VECTOR_STORE_DIR).
# File name is derived automatically: faces-<FACE_MODEL_ID>.npz  e.g. faces-buffalo_l.npz
FACE_STORE_DIR=/data/vectors

# Directory where InsightFace looks for pre-downloaded model packs.
# Must contain models/buffalo_l/ (downloaded at Docker build time — not fetched at runtime).
INSIGHTFACE_HOME=/root/.insightface

# Face detection confidence threshold (0–1).  Faces below this score are discarded.
# Tune on real photos: too low = background objects detected; too high = profiles missed.
FACE_DET_THRESH=0.5

# Minimum bounding-box dimension (pixels, in medium.jpg coordinates).
# Faces smaller than this in either width or height are discarded as too blurry to embed.
FACE_MIN_PX=40

# Identity matching threshold for nocne dopięcie (Phase 2 Iter 3).
# A face is matched to a known person when cosine similarity >= this value.
FACE_MATCH_THRESHOLD=0.50

# ── Phase 3 — event / trip detection ────────────────────────────────────────

# Home coordinates (decimal degrees).  Required for detect_events.py — the script
# refuses to run without them.  Used to filter out "sessions at home".
HOME_LAT=54.3520
HOME_LNG=18.6466

# Radius around home (km).  Sessions whose GPS centroid is within this radius
# are considered "home" and are not proposed as trips.
HOME_RADIUS_KM=25.0

# Gap in hours between consecutive photos that starts a new session.
EVENT_GAP_HOURS=6.0

# Minimum number of distinct calendar days a session must span to be a "trip".
# A value of 2 means the session must include photos on at least 2 different dates.
EVENT_MIN_DAYS=2

# Minimum number of photos in a session for it to be proposed as a trip.
EVENT_MIN_PHOTOS=10
